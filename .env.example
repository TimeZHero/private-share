APP_NAME="Private Share"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Reverse proxies allowed to set X-Forwarded-* headers (ignored when APP_ENV=local).
# Comma-separated IPs/CIDRs, or PRIVATE_SUBNETS. Leave empty when nothing sits in front of the app.
TRUSTED_PROXIES=

# Extra origins browser scripts may connect to (Content-Security-Policy connect-src), comma-separated.
# The app origin, the S3 bucket and the local Vite dev server are allowed automatically.
CSP_CONNECT_SRC=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FEATURE_AUTH=false
FEATURE_FILE_UPLOADS=false
FILE_DISK=local
FILE_MAX_SIZE_GB=10
# Daily upload allowance per user or guest link, in GB (0 = unlimited).
FILE_DAILY_QUOTA_GB=100
GUEST_LINK_TTL_HOURS=24

# Optional text shown at the bottom of the "How it works" modal (e.g. a support contact).
SUPPORT_HELP_TEXT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Google Workspace domains allowed to sign in, comma-separated and matched exactly
# (e.g. example.com,partner.io). Empty means nobody can sign in. The old regex-based
# AUTH_ALLOWED_EMAILS is no longer supported and keeps sign-in closed while set.
AUTH_ALLOWED_DOMAINS=

VITE_APP_NAME="${APP_NAME}"

BRANDING_LOGO_IMAGE=
BRANDING_LOGO_SHOW_CONTAINER=true
# All colors accept Tailwind names (purple, indigo, blue...) or hex (#7C3AED, EBFE50)
# BRANDING_PRIMARY=purple             # Main brand identity
# BRANDING_SECONDARY=indigo           # Supporting / glow color
# BRANDING_ACCENT=fuchsia             # Highlight / emphasis
# BRANDING_ACTION=                    # Interactive elements (buttons, toggles). Falls back to primary.
# BRANDING_BACKGROUND=#0f172a         # Surface / card backgrounds
# BRANDING_FOREGROUND=#e2e8f0         # Text / content color
